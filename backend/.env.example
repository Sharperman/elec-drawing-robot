# =============================================================
# elec-drawing-robot backend configuration
# Copy this file to .env and fill in the values
# =============================================================

# ---- OpenAI / LLM ----
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=16384

# ---- Server ----
PORT=8765
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Database ----
# DB_PATH defaults to backend/data/elec_robot.db

# ---- ChromaDB ----
# CHROMA_PATH defaults to backend/data/chroma
# CHROMA_COLLECTION_STANDARDS=drawing_standards
# CHROMA_COLLECTION_SYMBOLS=symbol_descriptions

# ---- AutoCAD ----
# AUTOCAD_VERSION=AutoCAD.Application
# AUTOCAD_RECONNECT_INTERVAL=30
# AUTOCAD_MAX_RETRY=3

# ---- YOLOv8 ----
# YOLO_MODEL_PATH=backend/recognition/models/elec_symbol_yolov8.pt
# YOLO_CONFIDENCE_THRESHOLD=0.5
# YOLO_IOU_THRESHOLD=0.45
# YOLO_IMG_SIZE=640
# YOLO_DEVICE=cpu

# ---- Logging ----
# LOG_LEVEL=INFO
# LOG_DIR=logs
# LOG_ROTATION=10 MB
# LOG_RETENTION=30 days

# ---- Agent ----
# AGENT_MAX_ITERATIONS=10
# AGENT_VERBOSE=false

# ---- Feedback ----
# FEEDBACK_REFINE_THRESHOLD=5
