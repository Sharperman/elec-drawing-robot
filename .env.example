# 环境变量示例（复制此文件为 .env 后填写真实值）

# LLM API 配置
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MODEL_NAME=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：使用国内 API（通义千问 / 混元 等，兼容 OpenAI 格式）
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-xxxx

# 运行配置
HOST=127.0.0.1
PORT=8765
DEBUG=false

# 数据库路径（相对项目根目录）
DB_PATH=backend/data/db/elec_robot.db
CHROMA_PATH=backend/data/chroma

# AutoCAD 配置
AUTOCAD_VERSION=AutoCAD.Application
AUTOCAD_TIMEOUT=30

# 语音识别（P1，暂未启用）
# SPEECH_ENGINE=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
